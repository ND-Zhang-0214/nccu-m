# 複製為 .env 後填入實際值
# 2026-08 起改用 PostgreSQL(原為 SQLite)。本機開發建議另外申請一個免費 Neon 專案/分支
# 專供開發用(與正式環境的 Neon 專案分開),或使用本機安裝的 PostgreSQL,例如:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/yanlian_dev"
# 部署到 Vercel 時,DATABASE_URL 請填 Neon 的「Pooled connection string」(主機名稱含
# -pooler),而不是 Direct connection——無伺服器環境下 Pooled 版本才不會把連線數用光,
# 詳見 GitHub上架步驟.md。
DATABASE_URL="postgresql://user:pass@localhost:5432/yanlian_dev"
SESSION_SECRET=""                       # 產生方式:openssl rand -hex 32
ALLOWED_EMAIL_DOMAINS="g.nccu.edu.tw,nccu.edu.tw"
LIFECYCLE_CRON_SCHEDULE="0 3 * * *"    # 帳號生命週期批次的排程頻率(cron 格式),見 src/server/scheduler.ts;不填則用此預設值(每日凌晨 3 點)。僅本機開發/自架伺服器適用——部署在 Vercel 時排程改由 vercel.json 的 Vercel Cron 負責,見 CRON_SECRET。

# ── 以下兩項僅部署在 Vercel 時需要,本機開發可以不填 ──────────────────
BLOB_READ_WRITE_TOKEN=""               # 建立 Vercel Blob store 後,Vercel 會自動注入此變數(見部署教學文件);本機不填則檔案上傳會改存在 private-uploads/ 目錄
CRON_SECRET=""                          # 產生方式同 SESSION_SECRET(openssl rand -hex 32)。設定後貼到 Vercel 專案的環境變數,src/app/api/cron/lifecycle/route.ts 會用它驗證排程請求確實來自 Vercel
