# 複製為 .env 後填入實際值
DATABASE_URL="file:./dev.db"           # 正式環境改為 postgresql://user:pass@host:5432/dbname
SESSION_SECRET=""                       # 產生方式:openssl rand -hex 32
ALLOWED_EMAIL_DOMAINS="g.nccu.edu.tw,nccu.edu.tw"
LIFECYCLE_CRON_SCHEDULE="0 3 * * *"    # 帳號生命週期批次的排程頻率(cron 格式),見 src/server/scheduler.ts;不填則用此預設值(每日凌晨 3 點)
